# Copy this file to  .env  (never commit .env) and fill in the two values from
# Supabase Dashboard > Project Settings > API (URL) and API Keys (Publishable key).
#
# Only the PUBLIC "publishable" key goes here (it starts with sb_publishable_). It is safe in the browser because
# Row Level Security (supabase/migrations) decides what it may read and write.
# NEVER put the "secret" or "service_role" key in this project: it bypasses all security.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-KEY

# Optional: set to false to hide the "Add image / Add video" buttons (do this for the public launch).
# VITE_EDIT_MEDIA=false
