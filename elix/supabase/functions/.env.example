# Secrets for the review Edge Functions. Set them with:  supabase secrets set --env-file supabase/functions/.env
# Copy to supabase/functions/.env (git-ignored) and fill in. NEVER put these in the website's .env or in React code.
# (SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided automatically by Supabase.)

# Required: any long random string (32+ characters). Generate one:  openssl rand -base64 48
OTP_PEPPER=

# Required: browsers allowed to call the functions, comma separated
ALLOWED_ORIGINS=https://your-domain.com,http://localhost:5173

# Email OTP (Resend). EMAIL_FROM must use a domain you have verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=The Elix <reviews@your-domain.com>

# SMS OTP (Twilio Verify)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# CAPTCHA (Cloudflare Turnstile secret key). Strongly recommended: it stops bots from running up your SMS bill.
TURNSTILE_SECRET_KEY=
